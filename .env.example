# ─────────────────────────────────────────────
# SERVICE
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=billing_service
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=false
DB_POOL_MAX=20

# ─────────────────────────────────────────────
# BITRIX24
# ─────────────────────────────────────────────
# Your Bitrix24 portal domain (no https://)
BITRIX_DOMAIN=mycompany.bitrix24.com
# Outbound webhook token (user_id/token pair)
BITRIX_USER_ID=1
BITRIX_WEBHOOK_TOKEN=abc123webhooktoken
# Shared secret used to verify inbound webhook signatures
BITRIX_INCOMING_WEBHOOK_SECRET=mysupersecrettoken
BITRIX_ENV=sandbox

# Custom field machine names in Bitrix24 CRM Deal
BITRIX_FIELD_CONTRACT_TEXT=UF_CRM_CONTRACT_TEXT
BITRIX_FIELD_CONTRACT_START=UF_CRM_CONTRACT_START
BITRIX_FIELD_CONTRACT_END=UF_CRM_CONTRACT_END
BITRIX_FIELD_LEDGERS_CONTACT_ID=UF_CRM_LEDGERS_CONTACT_ID
BITRIX_FIELD_LEDGERS_INVOICE_IDS=UF_CRM_LEDGERS_INVOICE_IDS

# ─────────────────────────────────────────────
# LEDGERS
# ─────────────────────────────────────────────
LEDGERS_API_KEY=your_ledgers_api_key_here
LEDGERS_BASE_URL=https://api.ledgers.io/v1
LEDGERS_ENV=sandbox

# ─────────────────────────────────────────────
# ANTHROPIC / CLAUDE
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-6

# ─────────────────────────────────────────────
# ADMIN API
# ─────────────────────────────────────────────
ADMIN_API_KEY=change_this_to_a_random_256bit_key

# ─────────────────────────────────────────────
# SCHEDULER (cron expressions)
# ─────────────────────────────────────────────
# Daily at midnight UTC – check all active billing schedules
BILLING_CHECK_CRON=0 0 * * *
# Hourly – process error queue retries
RETRY_PROCESSOR_CRON=0 * * * *

# ─────────────────────────────────────────────
# RETRY LOGIC
# ─────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=5
# Base delay in milliseconds for exponential backoff
RETRY_BASE_DELAY_MS=60000
